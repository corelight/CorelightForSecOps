            "dashboardQueries": [
                {
                    "name": "a8aa600d-bee8-4456-a6f3-73249b9e1800",
                    "query": "metadata.vendor_name=\"Corelight\"\r\nmetadata.product_event_type = \"software\" \r\n$name=target.asset.software.name\r\nmatch:\r\n    $name\r\noutcome:\r\n    $count=count_distinct(metadata.id)\r\norder:\r\n    $count desc \r\nlimit:\r\n    10",
                    "input": {
                        "relativeTime": {
                            "timeUnit": "DAY",
                            "startTimeVal": "1"
                        }
                    },
                    "etag": "9ce976bd22acc7a969bc448f844f3950d319553b55dedfa8065d92b0107c3734"
                },
                {
                    "name": "38d9ee2c-d525-4de7-8e57-dbd7fa4d2c38",
                    "query": "metadata.vendor_name=\"Corelight\"\r\nmetadata.product_event_type = \"software\" \r\n$name=target.asset.software.name\r\n$name!=\"\"\r\nmatch:\r\n    $name\r\noutcome:\r\n    $count=count_distinct(metadata.id)\r\norder:\r\n    $count desc \r\nlimit:\r\n    10",
                    "input": {
                        "relativeTime": {
                            "timeUnit": "DAY",
                            "startTimeVal": "1"
                        }
                    },
                    "etag": "5d4813cc58f7f985b62f45873915e39f96a7fd2ef8b0d0eabd2b4b53f83be065"
                },
                {
                    "name": "47820883-8c82-4c1d-9d57-e20f60cc2cbc",
                    "query": "metadata.vendor_name=\"Corelight\"\r\nmetadata.product_event_type = \"software\" \r\n$name=target.asset.software.name\r\n$name!=\"\"\r\n$version= strings.concat(if(target.asset.software.version!=\"\", target.asset.software.version, \"\"), \r\n          if(target.asset.attribute.labels[\"version_minor\"]!=\"\", strings.concat(\".\", target.asset.attribute.labels[\"version_minor\"]), \"\"), \r\n          if(target.asset.attribute.labels[\"version_minor2\"]!=\"\", strings.concat(\".\", target.asset.attribute.labels[\"version_minor2\"]), \"\"))\r\nmatch:\r\n    $name, $version\r\noutcome:\r\n    $count=count_distinct(metadata.id)\r\norder:\r\n    $count desc \r\nlimit:\r\n    10",
                    "input": {
                        "relativeTime": {
                            "timeUnit": "DAY",
                            "startTimeVal": "1"
                        }
                    },
                    "etag": "117d6d73d9e355cad13b8a950ef8c4f604f0ec44647b82fdc4f8621b02d6f106"
                },
                {
                    "name": "ca992655-f84f-4b8d-9776-111991799157",
                    "query": "metadata.vendor_name=\"Corelight\"\r\nmetadata.product_event_type = \"software\" \r\n$time=timestamp.get_timestamp(metadata.event_timestamp.seconds)\r\n$version= strings.concat(if(target.asset.software.version!=\"\", target.asset.software.version, \"\"), \r\n          if(target.asset.attribute.labels[\"version_minor\"]!=\"\", strings.concat(\".\", target.asset.attribute.labels[\"version_minor\"]), \"\"), \r\n          if(target.asset.attribute.labels[\"version_minor2\"]!=\"\", strings.concat(\".\", target.asset.attribute.labels[\"version_minor2\"]), \"\"))\r\n$version_details=target.asset.attribute.labels[\"version_addl\"]\r\nmatch:\r\n    $time, target.asset.ip, principal.port, target.asset.software.description, target.asset.software.name, $version, $version_details, target.asset.attribute.labels[\"unparsed_version\"]\r\norder:\r\n    $time desc",
                    "input": {
                        "relativeTime": {
