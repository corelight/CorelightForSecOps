                    "name": "391267cf-d902-4bab-9c97-549e4fb4df57",
                    "query": "metadata.vendor_name=\"Corelight\"\r\nmetadata.product_event_type=\"x509\" OR metadata.product_event_type = \"ssl\" OR metadata.product_event_type = \"ssl_red\" OR metadata.product_event_type = \"ssl_agg\"\r\nabout.domain.last_https_certificate.subject.common_name!=\"\" OR network.tls.server.certificate.subject!=\"\"\r\n$ssl_subject=strings.coalesce(about.domain.last_https_certificate.subject.common_name, network.tls.server.certificate.subject)\r\nmatch:\r\n    $ssl_subject\r\noutcome:\r\n    $count=count_distinct(metadata.id)\r\norder:\r\n    $count asc \r\nlimit:\r\n    10",
