                {
                    "name": "57e7c4c9-040e-42ad-99d3-0b32c0eab047",
                    "query": "metadata.vendor_name=\"Corelight\"\r\nmetadata.product_event_type = \"ssl\" OR metadata.product_event_type = \"ssl_red\" OR metadata.product_event_type = \"ssl_agg\"\r\nnetwork.tls.server.certificate.subject!=\"\" OR network.tls.client.server_name!=\"\"\r\n$c_id=if(network.tls.server.certificate.subject!=\"\", network.tls.server.certificate.subject, network.tls.client.server_name)\r\n$combined_fields=strings.concat(metadata.ingestion_labels.value, target.ip, principal.ip)\r\nmatch:\r\n    $c_id\r\noutcome:\r\n    $count=count_distinct($combined_fields)\r\norder:\r\n    $count desc \r\nlimit:\r\n    10\r\n",
                    "input": {
                        "relativeTime": {
